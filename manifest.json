{
  "id": "a7f3e9b2c1d4",
  "alias": "twitter",
  "name": "Twitter Plugin for SocialGata",
  "version": "1.9.1",
  "description": "Browse Twitter/X trending topics, search and user profiles via public Nitter instances",
  "script": "dist/index.js",
  "updateUrl": "https://cdn.jsdelivr.net/gh/InfoGata/twitter-socialgata@latest/manifest.json",
  "homepage": "https://github.com/InfoGata/twitter-socialgata",
  "siteMatch": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://twstalker.com/*"
  ],
  "redirects": [
    {
      "pattern": "https://twitter.com/:userId((?!(?:home|explore|notifications|messages|settings|search|compose|hashtag|intent|i|login|logout|signup|share|about|tos|privacy|account)$)[a-zA-Z0-9_]+)",
      "path": "/user/:userId"
    },
    {
      "pattern": "https://x.com/:userId((?!(?:home|explore|notifications|messages|settings|search|compose|hashtag|intent|i|login|logout|signup|share|about|tos|privacy|account)$)[a-zA-Z0-9_]+)",
      "path": "/user/:userId"
    },
    {
      "pattern": "https://twstalker.com/:userId((?!(?:search|trending|trends|login|signup|about|privacy|terms|contact|hashtag)$)[a-zA-Z0-9_]+)",
      "path": "/user/:userId"
    }
  ],
  "pageContextRequests": [
    "https://twstalker.com/*",
    "https://nohup.cz/*",
    "https://nitter.privacyredirect.com/*",
    "https://nitter.netbub.com/*",
    "https://nitter.r4fo.com/*",
    "https://nitter.jaydenha.uk/*",
    "https://nitter.catsarch.com/*",
    "https://ruf.st/*",
    "https://xnologin.com/*"
  ]
}
